      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT welcome_text, clinic_hours, address FROM clinic_settings WHERE id = 1 LIMIT 1;",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        220,
        0
      ],
      "id": "n02set",
      "name": "Load welcome_text",
      "credentials": {
        "mySql": {
          "id": "MYSQL_CRED",
          "name": "MySQL account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const trig = $('When Executed by Another Workflow').first().json;\nconst row = $input.first().json;\nconst welcome = row.welcome_text || '¡Hola! Bienvenido/a a la Clínica Oftalmológica Artigas.';\nconst hours = row.clinic_hours || '';\nconst address = row.address || '';\nconst content = `${welcome}\n\n🕘 *Horarios:* ${hours}\n📍 *Ubicación:* ${address}\n\n¿Necesitás un turno? Apretá el botón de abajo.`;\nreturn [{\n  json: {\n    telefono: trig.telefono,\n    conversation_id: trig.conversation_id,\n    account_id: trig.account_id,\n    cw_body: {\n      content,\n      message_type: 'outgoing',\n      private: false,\n      content_type: 'input_select',\n      content_attributes: {\n        items: [\n          { title: 'Sacar un turno', value: 'quiero_turno' }\n        ]\n      }\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "n02build",
      "name": "Build welcome message"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://chat.' + ($env.CHATWOOT_HOST || $env.DOMAIN) + '/api/v1/accounts/' + String($json.account_id) + '/conversations/' + String($json.conversation_id) + '/messages' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.cw_body }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "id": "n02http",
      "name": "Send Chatwoot welcome",
      "credentials": {
        "httpHeaderAuth": {
          "id": "CHATWOOT_CRED",
          "name": "Chatwoot API"
        }
      },
      "notesInFlow": true,
      "notes": "Credential 'Chatwoot API' = Header Auth, header name api_access_token. Or set CHATWOOT_HOST/DOMAIN in n8n env."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE conversation_state SET state = 'menu_shown' WHERE phone = '{{ $('When Executed by Another Workflow').item.json.telefono }}';",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
