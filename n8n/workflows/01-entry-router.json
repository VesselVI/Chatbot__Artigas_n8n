      "parameters": {
        "jsCode": "const n = $('Normalize Message').first().json;\nconst row = $input.first().json;\nlet ctx = row.context ?? {};\nif (typeof ctx === 'string') {\n  try { ctx = JSON.parse(ctx); } catch (e) { ctx = {}; }\n}\nreturn [{\n  json: {\n    telefono: n.telefono,\n    tipo: n.tipo,\n    texto: n.texto,\n    boton_id: n.boton_id,\n    conversation_id: n.conversation_id,\n    account_id: n.account_id,\n    estado: row.state || 'idle',\n    datos_json: ctx,\n    context: ctx,\n  }\n}];"
      },
