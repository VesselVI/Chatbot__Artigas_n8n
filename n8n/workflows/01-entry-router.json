      "parameters": {
        "jsCode": "const n = $('Normalize Message').first().json;\nconst row = $input.first().json;\nlet ctx = row.context ?? {};\nif (typeof ctx === 'string') {\n  try { ctx = JSON.parse(ctx); } catch (e) { ctx = {}; }\n}\nfunction fold(s) {\n  return String(s || '').trim().toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n}\nconst PREV_STEP = {\n  awaiting_dni: 'awaiting_nombre',\n  awaiting_obra_social: 'awaiting_dni',\n  awaiting_obra_social_otra: 'awaiting_obra_social',\n  awaiting_telefono: 'awaiting_obra_social',\n  awaiting_medico: 'awaiting_obra_social',\n  awaiting_dia_hora: 'awaiting_medico',\n  awaiting_confirmacion: 'awaiting_dia_hora',\n};\nconst CURRENT_KW = {\n  awaiting_nombre: /nombre completo/,\n  awaiting_dni: /dni/,\n  awaiting_obra_social: /obra social/,\n  awaiting_obra_social_otra: /nombre de tu obra social/,\n  awaiting_telefono: /telefono/,\n  awaiting_medico: /medico preferis|que medico/,\n  awaiting_dia_hora: /horario preferis/,\n  awaiting_confirmacion: /confirmas el turno/,\n};\nfunction quotedStep(texto) {\n  const f = fold(texto);\n  if (/confirmas el turno/.test(f)) return 'awaiting_confirmacion';\n  if (/nombre completo/.test(f)) return 'awaiting_nombre';\n  if (/cual es tu dni|tu dni|\\bdni\\b/.test(f)) return 'awaiting_dni';\n  if (/nombre de tu obra social/.test(f)) return 'awaiting_obra_social_otra';\n  if (/obra social/.test(f)) return 'awaiting_obra_social';\n  if (/numero de telefono/.test(f)) return 'awaiting_telefono';\n  if (/medico preferis|que medico/.test(f)) return 'awaiting_medico';\n  if (/horario preferis/.test(f)) return 'awaiting_dia_hora';\n  return null;\n}\nlet estado = row.state || 'idle';\nconst boton = String(n.boton_id || '').trim();\nconst texto = String(n.texto || '').replace(/\\n?__cw_in_reply_to__:\\S+/g, '').trim();\nconst lines = texto.split(/\\r?\\n/).map(x => x.trim()).filter(Boolean);\nconst last = lines.length ? lines[lines.length - 1] : texto;\nconst isRepetir = boton === 'repetir_pregunta'\n  || /^(repetir|repetir pregunta)$/i.test(fold(last))\n  || lines.some(l => /^(repetir|repetir pregunta)$/i.test(fold(l)));\nif (isRepetir && /^awaiting_/.test(estado)) {\n  let q = quotedStep(texto);\n  if (!q) {\n    const kw = CURRENT_KW[estado];\n    if (!kw || !kw.test(fold(texto))) q = PREV_STEP[estado] || null;\n  }\n  if (q) {\n    const order = ['awaiting_nombre','awaiting_dni','awaiting_obra_social','awaiting_obra_social_otra','awaiting_telefono','awaiting_medico','awaiting_dia_hora','awaiting_confirmacion'];\n    const cur = order.indexOf(estado);\n    const tgt = order.indexOf(q);\n    if (tgt >= 0 && (cur < 0 || tgt <= cur)) estado = q;\n  }\n}\nreturn [{\n  json: {\n    telefono: n.telefono,\n    tipo: n.tipo,\n    texto: n.texto,\n    boton_id: n.boton_id,\n    conversation_id: n.conversation_id,\n    account_id: n.account_id,\n    estado,\n    datos_json: ctx,\n    context: ctx,\n  }\n}];"
