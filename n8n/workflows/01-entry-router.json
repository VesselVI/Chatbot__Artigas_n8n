      "parameters": {
        "jsCode": "const item = $input.first().json;\nlet estado = item.estado || 'idle';\nconst boton = String(item.boton_id || '').trim();\nconst texto = String(item.texto || '').trim();\nconst lines = texto.split(/\\r?\\n/).map(x => x.trim()).filter(Boolean);\nconst last = lines.length ? lines[lines.length - 1] : texto;\nconst lastLower = last.toLowerCase();\nconst textoLower = lastLower;\nconst onMenu = estado === 'idle' || estado === 'menu_shown';\n\nconst cancelKw = boton === 'cancelar_turno_pedido' || boton === 'cancelar_turno'\n  || /^(cancelar|salir|menu|menú)$/i.test(lastLower)\n  || /^cancelar turno$/i.test(lastLower);\nconst isAwaiting = /^awaiting_/.test(estado);\nconst yes = boton === 'cancel_si' || /^(si|sí)$/i.test(lastLower) || /sí,? cancelar/i.test(lastLower) || /si,? cancelar/i.test(lastLower);\nconst no = boton === 'cancel_no' || /^no$/i.test(lastLower) || /no,? continuar/i.test(lastLower);\nconst isRepetir = boton === 'repetir_pregunta' || /^(repetir|repetir pregunta)$/i.test(lastLower) || lines.some(l => /^(repetir|repetir pregunta)$/i.test(l));\nconst lastFold = lastLower.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\nconst isHorarios = boton === 'horarios_clinica'\n  || (onMenu && (lastFold === '1' || /^(horarios|horarios( de( la)?)? clinica)$/i.test(lastFold)));\nconst isTurno = boton === 'quiero_turno' || boton === 'confirmar_turno'\n  || (onMenu && (lastFold === '2' || /\\bturn[oaie]s?\\b|\\bcitas?\\b|sacar\\s+(un\\s+)?turn/i.test(lastFold)));\nconst isMenuKw = boton === 'volver_menu'\n  || /^(menu|volver|volver al menu)$/i.test(lastFold);\nconst isGreeting = /^(hola+|holis|buenas|buenos|buen[oa]s?( (dias|tardes|noches))?|hi|hey|hello|que tal)$/i.test(lastFold);\n\nlet route = 'welcome';\n\nif (estado === 'confirmando_cancelacion') {\n  if (yes) route = 'cancel_yes';\n  else if (no) route = 'cancel_no';\n  else route = 'cancel_ask';\n} else if (cancelKw && isAwaiting) {\n  route = 'cancel_ask';\n} else if (isRepetir && isAwaiting) {\n  route = 'booking';\n} else if (isHorarios) {\n  route = 'horarios';\n} else if (isMenuKw || isGreeting) {\n  route = 'welcome';\n} else if (isTurno || isAwaiting) {\n  route = 'booking';\n} else if (estado === 'menu_shown' && texto && !boton) {\n  route = 'faq';\n} else {\n  route = 'welcome';\n}\n\nreturn [{ json: { ...item, estado, texto, last_line: last, route } }];"
