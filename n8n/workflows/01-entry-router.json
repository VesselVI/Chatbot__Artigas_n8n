      "id": "n01wh",
      "name": "Chatwoot Webhook",
      "webhookId": "cw-bot-webhook"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body || raw;\n\n// Agent bot / webhook shapes\nconst event = body.event || body.message?.event || '';\nconst msg = body.message || body;\n\n// Drop non-message events\nif (event && !String(event).includes('message_created') && event !== 'message_updated') {\n  // allow bare message payloads without event\n  if (!msg.content && !msg.content_type && !body.content) return [];\n}\n\nconst message = (body.content !== undefined && body.conversation) ? body : msg;\nconst conversation = message.conversation || body.conversation || {};\nconst account = message.account || body.account || {};\nconst sender = message.sender || conversation.meta?.sender || {};\n\nconst messageType = message.message_type;\n// 0=incoming, 1=outgoing, 2=activity — also string forms\nconst isIncoming = messageType === 0 || messageType === 'incoming' || messageType === 'Incoming';\nconst isPrivate = message.private === true;\nconst senderType = (sender.type || '').toLowerCase();\n\nif (isPrivate) return [];\nif (messageType === 1 || messageType === 'outgoing' || messageType === 'Outgoing') return [];\nif (senderType === 'user' || senderType === 'agent_bot') return [];\n// If clearly not incoming and has message_type, drop\nif (messageType !== undefined && messageType !== null && !isIncoming && messageType !== 'incoming') return [];\n\nif (conversation.assignee_id) return []; // human handoff — skip bot reply\n\nlet phone = sender.phone_number || conversation.meta?.sender?.phone_number || conversation.contact_inbox?.source_id || '';\nphone = String(phone).replace(/\\s+/g, '').replace(/^\\+/, '');\nif (phone.startsWith('549')) phone = '54' + phone.slice(3);\n\nlet texto = message.content || '';\nlet boton_id = '';\nconst ca = message.content_attributes || {};\nconst submitted = ca.submitted_values || ca.items || [];\nif (Array.isArray(submitted) && submitted.length) {\n  const v = submitted[0];\n  boton_id = String(v.value ?? v.id ?? '');\n  if (!texto) texto = String(v.title ?? v.value ?? '');\n}\n// Some Chatwoot WhatsApp payloads put selection in content_attributes.submitted_values differently\nif (!boton_id && ca.submitted_values && typeof ca.submitted_values === 'object' && !Array.isArray(ca.submitted_values)) {\n  boton_id = String(ca.submitted_values.value || '');\n}\n\nconst contentType = message.content_type || 'text';\nconst tipo = boton_id ? 'interactive' : (contentType === 'text' || contentType === 'input_select' ? (boton_id ? 'interactive' : 'text') : 'text');\n\nif (!phone && !conversation.id && !conversation.display_id) return [];\n\nconst conversationId = conversation.display_id || conversation.id || body.conversation_id;\nconst accountId = conversation.account_id || account.id || body.account?.id || body.account_id;\n\nreturn [{\n  json: {\n    telefono: phone || String(conversationId),\n    tipo: boton_id ? 'interactive' : 'text',\n    texto: texto || '',\n    boton_id: boton_id || '',\n    conversation_id: conversationId,\n    account_id: accountId,\n  }\n}];"
      },
