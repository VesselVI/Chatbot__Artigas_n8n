    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst estado = item.estado || 'idle';\nconst boton = String(item.boton_id || '').trim();\nconst texto = String(item.texto || '').trim();\nconst textoLower = texto.toLowerCase();\n\nconst cancelKw = boton === 'cancelar_turno_pedido' || boton === 'cancelar_turno' || /^(cancelar|salir|menu|menú)$/i.test(textoLower);\nconst isAwaiting = /^awaiting_/.test(estado);\nconst yes = boton === 'cancel_si' || /^(si|sí)$/i.test(textoLower) || /sí,? cancelar/i.test(textoLower) || /si,? cancelar/i.test(textoLower);\nconst no = boton === 'cancel_no' || /^no$/i.test(textoLower) || /no,? continuar/i.test(textoLower);\n\nlet route = 'welcome';\n\nif (estado === 'confirmando_cancelacion') {\n  if (yes) route = 'cancel_yes';\n  else if (no) route = 'cancel_no';\n  else route = 'cancel_ask';\n} else if (cancelKw && isAwaiting) {\n  route = 'cancel_ask';\n} else if (boton === 'repetir_pregunta' && isAwaiting) {\n  route = 'booking';\n} else if (boton === 'horarios_clinica') {\n  route = 'horarios';\n} else if (boton === 'volver_menu') {\n  route = 'welcome';\n} else if (boton === 'quiero_turno' || boton === 'confirmar_turno' || isAwaiting) {\n  route = 'booking';\n} else if (estado === 'menu_shown' && texto && !boton) {\n  route = 'faq';\n} else {\n  route = 'welcome';\n}\n\nreturn [{ json: { ...item, route } }];"
      },
