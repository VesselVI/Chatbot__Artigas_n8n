      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body || raw;\n\nconst event = body.event || body.message?.event || '';\nconst msg = body.message || body;\n\nif (event && !String(event).includes('message_created') && event !== 'message_updated') {\n  if (!msg.content && !msg.content_type && !body.content) return [];\n}\n\nconst message = (body.content !== undefined && body.conversation) ? body : msg;\nconst conversation = message.conversation || body.conversation || {};\nconst account = message.account || body.account || {};\nconst sender = message.sender || conversation.meta?.sender || {};\n\nconst messageType = message.message_type;\nconst isIncoming = messageType === 0 || messageType === 'incoming' || messageType === 'Incoming';\nconst isPrivate = message.private === true;\nconst senderType = (sender.type || '').toLowerCase();\n\nif (isPrivate) return [];\nif (messageType === 1 || messageType === 'outgoing' || messageType === 'Outgoing') return [];\nif (senderType === 'user' || senderType === 'agent_bot') return [];\nif (messageType !== undefined && messageType !== null && !isIncoming && messageType !== 'incoming') return [];\n\nif (conversation.assignee_id) return [];\n\nlet phone = sender.phone_number || conversation.meta?.sender?.phone_number || conversation.contact_inbox?.source_id || '';\nphone = String(phone).replace(/\\s+/g, '').replace(/^\\+/, '');\nif (phone.startsWith('549')) phone = '54' + phone.slice(3);\n\nfunction fold(s) {\n  return String(s || '').trim().toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n}\n\nlet texto = String(message.content || '').trim();\nconst lines = texto.split(/\\r?\\n/).map(x => x.trim()).filter(Boolean);\nconst last = lines.length ? lines[lines.length - 1] : texto;\n\nlet boton_id = '';\nconst ca = message.content_attributes || {};\nconst submitted = ca.submitted_values || ca.items || [];\nif (Array.isArray(submitted) && submitted.length) {\n  const v = submitted[0];\n  boton_id = String(v.value || v.id || '');\n  if (!texto) texto = String(v.title ?? v.value ?? '');\n}\nif (!boton_id && ca.submitted_values && typeof ca.submitted_values === 'object' && !Array.isArray(ca.submitted_values)) {\n  boton_id = String(ca.submitted_values.value || '');\n}\n\nconst quoteBits = [];\nconst replyId = ca.in_reply_to || ca.in_reply_to_id || message.in_reply_to || '';\nconst convMsgs = conversation.messages || body.conversation?.messages || [];\nif (replyId && Array.isArray(convMsgs)) {\n  const quoted = convMsgs.find(m => String(m.id) === String(replyId) || String(m.source_id || '') === String(ca.in_reply_to_external_id || ''));\n  if (quoted && quoted.content) quoteBits.push(String(quoted.content));\n}\nfor (const k of ['in_reply_to_content', 'quoted_content', 'quoted_message']) {\n  const v = ca[k];\n  if (typeof v === 'string' && v.trim()) quoteBits.push(v);\n  else if (v && typeof v === 'object' && v.content) quoteBits.push(String(v.content));\n}\nif (quoteBits.length) texto = quoteBits.join('\\n') + '\\n' + texto;\nif (replyId) texto += '\\n__cw_in_reply_to__:' + replyId;\n\nconst titleMap = {\n  'horarios de clinica': 'horarios_clinica',\n  'horarios clinica': 'horarios_clinica',\n  'sacar un turno': 'quiero_turno',\n  'volver al menu': 'volver_menu',\n  'volver': 'volver_menu',\n  'menu': 'volver_menu',\n  'repetir pregunta': 'repetir_pregunta',\n  'repetir': 'repetir_pregunta',\n  'cancelar turno': 'cancelar_turno_pedido',\n  'si, cancelar': 'cancel_si',\n  'si cancelar': 'cancel_si',\n  'no, continuar': 'cancel_no',\n  'no continuar': 'cancel_no',\n  'cualquier doctor': 'medico_cualquiera',\n  'mi medico de cabecera': 'medico_cabecera',\n  'otra / particular': 'obra_otra',\n  'otra': 'obra_otra',\n  'confirmar': 'confirmar_turno',\n};\n\nif (Array.isArray(submitted) && submitted.length && !boton_id) {\n  const t = fold(submitted[0].title || '');\n  if (titleMap[t]) boton_id = titleMap[t];\n}\n\nif (!boton_id) {\n  boton_id = titleMap[fold(last)] || '';\n}\nif (!boton_id) {\n  const navIds = new Set(['repetir_pregunta', 'cancelar_turno_pedido', 'cancel_si', 'cancel_no', 'volver_menu', 'confirmar_turno']);\n  for (const c of lines) {\n    const mapped = titleMap[fold(c)];\n    if (mapped && navIds.has(mapped)) { boton_id = mapped; break; }\n  }\n}\n\nif (!phone && !conversation.id && !conversation.display_id) return [];\n\nconst conversationId = conversation.display_id || conversation.id || body.conversation_id; // Chatwoot API path uses display_id\nconst accountId = conversation.account_id || account.id || body.account?.id || body.account_id;\n\nreturn [{\n  json: {\n    telefono: phone || String(conversationId),\n    tipo: boton_id ? 'interactive' : 'text',\n    texto: texto || '',\n    boton_id: boton_id || '',\n    conversation_id: conversationId,\n    account_id: accountId,\n  }\n}];"
