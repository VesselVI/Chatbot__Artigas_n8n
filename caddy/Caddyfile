{$DOMAIN} {
  redir https://dash.{$DOMAIN} permanent
}

n8n.{$DOMAIN} {
  reverse_proxy n8n:5678
}

dash.{$DOMAIN} {
  reverse_proxy dashboard:8000
}

chat.{$DOMAIN} {
  reverse_proxy chatwoot-rails:3000 {
    # Chatwoot auth uses api_access_token (underscores). Some clients send api-access-token.
    header_up api_access_token {http.request.header.api-access-token}
  }
}
