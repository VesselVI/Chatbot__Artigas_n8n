# Domain (point A records: n8n., chat., dash. → VPS IP)
DOMAIN=example.com
# Root domain only (no https://, no chat. prefix).
# Workflows build https://chat.CHATWOOT_HOST/...
CHATWOOT_HOST=example.com

# MySQL (chatbot DB)
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=artigas_bot
MYSQL_USER=artigas
MYSQL_PASSWORD=change_me_mysql

# Dashboard login
DASHBOARD_USERNAME=secretaria
DASHBOARD_PASSWORD=change_me_dashboard
DASHBOARD_SECRET_KEY=change_me_to_long_random_string

# n8n
N8N_ENCRYPTION_KEY=change_me_32chars_minimum_secret!!
N8N_HOST=n8n.example.com
WEBHOOK_URL=https://n8n.example.com/

# Chatwoot
CHATWOOT_SECRET_KEY_BASE=generate_with_openssl_rand_hex_64
CHATWOOT_POSTGRES_PASSWORD=change_me_cw_pg
FRONTEND_URL=https://chat.example.com
# Numeric id of the Secretaría team (Settings → Teams). Bot assigns here after "Hablar secretaria".
CHATWOOT_TEAM_ID=
# Display name for @team mention in the handoff private note (must match Chatwoot team name).
CHATWOOT_TEAM_NAME=Secretaría

# Timezone
TZ=America/Argentina/Buenos_Aires
